<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">#090C11</item>
        <item name="colorPrimaryDark">#090C11</item>
        <item name="colorAccent">#34D399</item>
        <item name="android:windowBackground">#090C11</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">#090C11</item>
        <item name="android:windowBackground">#090C11</item>
        <item name="android:statusBarColor">#090C11</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#090C11</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">#090C11</item>
        <item name="android:windowBackground">#090C11</item>
        <item name="windowSplashScreenBackground">#090C11</item>
        <item name="windowSplashScreenAnimatedIcon">@null</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>