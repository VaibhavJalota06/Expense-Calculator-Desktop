{
  "name": "expense-calculator-desktop",
  "version": "2.4.8",
  "description": "Expense OS - Futuristic Dark Glassmorphic Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "publish": "node scripts/publish-release.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VaibhavJalota06/Expense-Calculator-Desktop.git"
  },
  "build": {
    "appId": "com.expensecalculator.app",
    "productName": "Expense OS",
    "files": [
      "!dist{,/**}",
      "!dist-verify{,/**}",
      "!release{,/**}"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "VaibhavJalota06",
        "repo": "Expense-Calculator-Desktop"
      }
    ],
    "forceCodeSigning": false,
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "sign": null,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  },
  "keywords": [
    "expense",
    "calculator",
    "budget",
    "desktop",
    "windows",
    "glassmorphism"
  ],
  "author": "Expense Cal",
  "license": "ISC",
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2"
  }
}
